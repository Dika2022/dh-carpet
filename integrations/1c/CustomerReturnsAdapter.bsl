// READ ONLY адаптер полного snapshot возврата от покупателя.
// Код предназначен для серверного общего модуля расширения 1С.

Функция СформироватьПакетВозвратаПокупателя(СсылкаДокумента, СмещениеЧасовогоПояса) Экспорт
    // Историческое имя параметра сохранено; фактически это текущий ДокументОбъект.
    // В ПриЗаписи передаётся объект: повторное чтение Документ.ПриходнаяНакладная.Запасы
    // из базы вернуло бы состояние до текущей записи.
    Если ТипЗнч(СсылкаДокумента) <> Тип("ДокументОбъект.ПриходнаяНакладная") Тогда
        ВызватьИсключение "Ожидался объект Документ.ПриходнаяНакладная";
    КонецЕсли;

    UUIDДокумента = Строка(СсылкаДокумента.Ссылка.УникальныйИдентификатор());
    ЭтоВозврат = СсылкаДокумента.Проведен
        И СсылкаДокумента.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ВозвратОтПокупателя;

    События = Новый Массив;
    КлючиСтрок = Новый Массив;
    Если ЭтоВозврат Тогда
        Для Каждого СтрокаЗапасов Из СсылкаДокумента.Запасы Цикл
            ПроверитьКлючевыеПоляВозврата(СтрокаЗапасов, UUIDДокумента);
            КлючСтроки = Строка(СтрокаЗапасов.ИдентификаторСтроки);
            КлючиСтрок.Добавить(КлючСтроки);

            Штрихкод = СтрокаЗапасов.Номенклатура.Штрихкод;
            Артикул = СтрокаЗапасов.Номенклатура.Артикул;

            Payload = Новый Структура;
            Payload.Вставить("document_uuid", UUIDДокумента);
            Payload.Вставить("line_id", КлючСтроки);
            Payload.Вставить("nomenclature_uuid", Строка(СтрокаЗапасов.Номенклатура.УникальныйИдентификатор()));
            Payload.Вставить("nomenclature", Строка(СтрокаЗапасов.Номенклатура));
            Payload.Вставить("article", Артикул);
            Payload.Вставить("barcode", Штрихкод);
            Payload.Вставить("posted", Истина);

            Событие = Новый Структура;
            Событие.Вставить("barcode", Штрихкод);
            Событие.Вставить("event_type", "customer_return");
            Событие.Вставить("event_at", Формат(СсылкаДокумента.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss") + СмещениеЧасовогоПояса);
            Событие.Вставить("price", СтрокаЗапасов.Цена);
            Событие.Вставить("qty", СтрокаЗапасов.Количество);
            Событие.Вставить("unit", Строка(СтрокаЗапасов.ЕдиницаИзмерения));
            Событие.Вставить("counterparty", Строка(СсылкаДокумента.Контрагент));
            Событие.Вставить("source_ref", UUIDДокумента);
            Событие.Вставить("source_line_key", КлючСтроки);
            Событие.Вставить("posted", Истина);
            Событие.Вставить("payload", Payload);
            События.Добавить(Событие);
        КонецЦикла;
    КонецЕсли;

    Snapshot = Новый Структура;
    Snapshot.Вставить("event_type", "customer_return");
    Snapshot.Вставить("source_ref", UUIDДокумента);
    Snapshot.Вставить("posted", ЭтоВозврат);
    Snapshot.Вставить("line_keys", КлючиСтрок);

    Пакет = Новый Структура;
    Пакет.Вставить("mode", "incremental");
    Пакет.Вставить("rugs", Новый Массив);
    Пакет.Вставить("events", События);
    Snapshots = Новый Массив;
    Snapshots.Добавить(Snapshot);
    Пакет.Вставить("document_snapshots", Snapshots);
    Возврат Пакет;
КонецФункции

Процедура ПроверитьКлючевыеПоляВозврата(СтрокаЗапасов, UUIDДокумента)
    Если Не ЗначениеЗаполнено(СтрокаЗапасов.ИдентификаторСтроки) Тогда
        ВызватьИсключение "Не заполнен ИдентификаторСтроки в приходной накладной " + UUIDДокумента;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(СтрокаЗапасов.Номенклатура) Тогда
        ВызватьИсключение "Не заполнена Номенклатура в приходной накладной " + UUIDДокумента;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(СтрокаЗапасов.Номенклатура.Штрихкод) Тогда
        ВызватьИсключение "Не заполнен Штрихкод номенклатуры в приходной накладной " + UUIDДокумента;
    КонецЕсли;
КонецПроцедуры
