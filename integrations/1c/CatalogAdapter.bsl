// READ ONLY адаптер первоначальной выгрузки каталога ковров в dh-carpet.
// Код предназначен для серверного общего модуля ДХКоверКаталогСервер.
// Он не записывает данные в 1С и не обращается напрямую к SQL-базе 1С.

Функция ВыполнитьПервоначальнуюВыгрузку(АдресСервера, КлючAPI) Экспорт
    ПроверитьПравоПервоначальнойВыгрузки();

    Подготовка = ПодготовитьКаталог();
    Отчет = Подготовка.Отчет;
    Ковры = Подготовка.Ковры;
    РазмерПакета = 200;
    НомерПакета = 0;

    Пока Ковры.Количество() > 0 Цикл
        НомерПакета = НомерПакета + 1;
        ПакетКовров = ИзвлечьНачалоМассива(Ковры, РазмерПакета);

        Пакет = Новый Структура;
        Пакет.Вставить("mode", "initial");
        Пакет.Вставить("rugs", ПакетКовров);
        Пакет.Вставить("events", Новый Массив);
        Пакет.Вставить("document_snapshots", Новый Массив);

        Попытка
            ОтветHTTP = ДХКоверТранспортСервер.ОтправитьПакетDhCarpet(
                АдресСервера,
                КлючAPI,
                Пакет);
            Если ОтветHTTP.КодСостояния < 200 Или ОтветHTTP.КодСостояния >= 300 Тогда
                Отчет.Вставить("status", "failed");
                Отчет.Вставить(
                    "transport_error",
                    "Пакет " + Строка(НомерПакета)
                        + ": backend вернул HTTP " + Строка(ОтветHTTP.КодСостояния));
                Возврат Отчет;
            КонецЕсли;

            ОтветПакета = ПрочитатьОтветBackend(ОтветHTTP);
        Исключение
            Отчет.Вставить("status", "failed");
            Отчет.Вставить(
                "transport_error",
                "Пакет " + Строка(НомерПакета) + ": " + ОписаниеОшибки());
            Возврат Отчет;
        КонецПопытки;

        Отчет.sent_items = Отчет.sent_items + ПакетКовров.Количество();
        Отчет.backend_succeeded = Отчет.backend_succeeded + ОтветПакета.succeeded_items;
        Отчет.backend_failed = Отчет.backend_failed + ОтветПакета.failed_items;

        РезультатПакета = Новый Структура;
        РезультатПакета.Вставить("package_number", НомерПакета);
        РезультатПакета.Вставить("run_id", ОтветПакета.run_id);
        РезультатПакета.Вставить("status", ОтветПакета.status);
        РезультатПакета.Вставить("total_items", ОтветПакета.total_items);
        РезультатПакета.Вставить("succeeded_items", ОтветПакета.succeeded_items);
        РезультатПакета.Вставить("failed_items", ОтветПакета.failed_items);
        РезультатПакета.Вставить("failed_results", ОшибкиПакета(ОтветПакета));
        Отчет.runs.Добавить(РезультатПакета);
    КонецЦикла;

    Если Отчет.local_errors.Количество() > 0
        Или Отчет.warnings.Количество() > 0
        Или Отчет.backend_failed > 0 Тогда
        Отчет.Вставить("status", "completed_with_errors");
    Иначе
        Отчет.Вставить("status", "completed");
    КонецЕсли;
    Возврат Отчет;
КонецФункции

Функция ПодготовитьКаталог() Экспорт
    ПроверитьПравоПервоначальнойВыгрузки();

    Корни = Новый Структура;
    Корни.Вставить("Ковры", НайтиЕдинственнуюКорневуюГруппу("Ковры"));
    Корни.Вставить("Ковролины", НайтиЕдинственнуюКорневуюГруппу("Ковролины"));
    Корни.Вставить("Шкуры", НайтиЕдинственнуюКорневуюГруппу("Шкуры"));

    Позиции = Новый Массив;
    ДобавитьНоменклатуруГруппы(Позиции, Корни.Ковры, "Ковры", "rug");
    ДобавитьНоменклатуруГруппы(Позиции, Корни.Ковролины, "Ковролины", "carpet");
    ДобавитьНоменклатуруГруппы(Позиции, Корни.Шкуры, "Шкуры", "hide");

    Ссылки = Новый Массив;
    ПозицииПоСсылке = Новый Соответствие;
    Для Каждого Позиция Из Позиции Цикл
        Ссылки.Добавить(Позиция.Ссылка);
        ПозицииПоСсылке.Вставить(Позиция.Ссылка, Позиция);
    КонецЦикла;

    ЗаполнитьОстатки(Ссылки, ПозицииПоСсылке);
    ЗаполнитьРозничныеЦены(Ссылки, ПозицииПоСсылке);

    Отчет = Новый Структура;
    Отчет.Вставить("status", "prepared");
    Отчет.Вставить("catalog_items_found", Позиции.Количество());
    Отчет.Вставить("ready_items", 0);
    Отчет.Вставить("sent_items", 0);
    Отчет.Вставить("backend_succeeded", 0);
    Отчет.Вставить("backend_failed", 0);
    Отчет.Вставить("local_errors", Новый Массив);
    Отчет.Вставить("warnings", Новый Массив);
    Отчет.Вставить("runs", Новый Массив);

    КоличествоШтрихкодов = Новый Соответствие;
    Для Каждого Позиция Из Позиции Цикл
        Штрихкод = СокрЛП(Строка(Позиция.Штрихкод));
        Если Штрихкод <> "" Тогда
            Количество = КоличествоШтрихкодов.Получить(Штрихкод);
            Если Количество = Неопределено Тогда
                Количество = 0;
            КонецЕсли;
            КоличествоШтрихкодов.Вставить(Штрихкод, Количество + 1);
        КонецЕсли;
    КонецЦикла;

    Ковры = Новый Массив;
    Для Каждого Позиция Из Позиции Цикл
        Штрихкод = СокрЛП(Строка(Позиция.Штрихкод));
        Если Штрихкод = "" Тогда
            ДобавитьПроблему(
                Отчет.local_errors,
                "missing_barcode",
                Позиция,
                "Позиция не отправлена: barcode обязателен в backend contract");
            Продолжить;
        КонецЕсли;
        Если СтрДлина(Штрихкод) > 64 Тогда
            ДобавитьПроблему(
                Отчет.local_errors,
                "barcode_too_long",
                Позиция,
                "Позиция не отправлена: barcode длиннее 64 символов");
            Продолжить;
        КонецЕсли;
        Если КоличествоШтрихкодов.Получить(Штрихкод) > 1 Тогда
            ДобавитьПроблему(
                Отчет.local_errors,
                "duplicate_barcode",
                Позиция,
                "Позиция не отправлена: barcode встречается в каталоге несколько раз");
            Продолжить;
        КонецЕсли;
        Если СокрЛП(Строка(Позиция.Наименование)) = "" Тогда
            ДобавитьПроблему(
                Отчет.local_errors,
                "missing_name",
                Позиция,
                "Позиция не отправлена: name обязателен в backend contract");
            Продолжить;
        КонецЕсли;

        Ковры.Добавить(СформироватьКовер(Позиция, Отчет));
    КонецЦикла;

    Отчет.ready_items = Ковры.Количество();
    Возврат Новый Структура("Ковры,Отчет", Ковры, Отчет);
КонецФункции

Процедура ПроверитьПравоПервоначальнойВыгрузки()
    Если Не РольДоступна("ДХКоверАдминистраторИнтеграции") Тогда
        ВызватьИсключение
            "Первоначальная выгрузка доступна только роли ДХКоверАдминистраторИнтеграции";
    КонецЕсли;
КонецПроцедуры

Функция НайтиЕдинственнуюКорневуюГруппу(Наименование)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 2
    |   Номенклатура.Ссылка КАК Ссылка
    |ИЗ
    |   Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |   Номенклатура.ЭтоГруппа
    |   И НЕ Номенклатура.ПометкаУдаления
    |   И Номенклатура.Наименование = &Наименование";
    Запрос.УстановитьПараметр("Наименование", Наименование);
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() <> 1 Тогда
        ВызватьИсключение
            "Ожидалась ровно одна непомеченная группа Номенклатура с именем "
                + Наименование + ", найдено: " + Строка(Таблица.Количество());
    КонецЕсли;
    Возврат Таблица[0].Ссылка;
КонецФункции

Процедура ДобавитьНоменклатуруГруппы(Позиции, КорневаяГруппа, ИмяКорня, Категория)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Номенклатура.Ссылка КАК Ссылка,
    |   Номенклатура.Наименование КАК Наименование,
    |   Номенклатура.Артикул КАК Артикул,
    |   Номенклатура.Штрихкод КАК Штрихкод,
    |   Номенклатура.Длина КАК Длина,
    |   Номенклатура.Ширина КАК Ширина,
    |   Номенклатура.Вес КАК Вес,
    |   Номенклатура.Описание КАК Описание,
    |   Номенклатура.Комментарий КАК Комментарий
    |ИЗ
    |   Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |   Номенклатура.Ссылка В ИЕРАРХИИ(&КорневаяГруппа)
    |   И НЕ Номенклатура.ЭтоГруппа
    |   И НЕ Номенклатура.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО
    |   Номенклатура.Ссылка";
    Запрос.УстановитьПараметр("КорневаяГруппа", КорневаяГруппа);

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Позиция = Новый Структура;
        Позиция.Вставить("Ссылка", Выборка.Ссылка);
        Позиция.Вставить("КорневаяГруппа", ИмяКорня);
        Позиция.Вставить("Категория", Категория);
        Позиция.Вставить("Наименование", Выборка.Наименование);
        Позиция.Вставить("Артикул", Выборка.Артикул);
        Позиция.Вставить("Штрихкод", Выборка.Штрихкод);
        Позиция.Вставить("Длина", Выборка.Длина);
        Позиция.Вставить("Ширина", Выборка.Ширина);
        Позиция.Вставить("Вес", Выборка.Вес);
        Позиция.Вставить("Описание", Выборка.Описание);
        Позиция.Вставить("Комментарий", Выборка.Комментарий);
        Позиция.Вставить("Остатки", Новый Массив);
        Позиция.Вставить("Цены", Новый Массив);
        Позиции.Добавить(Позиция);
    КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьОстатки(Ссылки, ПозицииПоСсылке)
    Смещение = 0;
    Пока Смещение < Ссылки.Количество() Цикл
        ЧастьСсылок = ЧастьМассива(Ссылки, Смещение, 500);
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |   Остатки.Номенклатура КАК Номенклатура,
        |   Остатки.Организация КАК Организация,
        |   Остатки.Характеристика КАК Характеристика,
        |   Остатки.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
        |   Остатки.Ячейка КАК Ячейка,
        |   Остатки.КоличествоОстаток КАК Количество
        |ИЗ
        |   РегистрНакопления.ЗапасыНаСкладах.Остатки(
        |       , Номенклатура В (&Номенклатура)) КАК Остатки
        |УПОРЯДОЧИТЬ ПО
        |   Остатки.Номенклатура,
        |   Остатки.СтруктурнаяЕдиница,
        |   Остатки.Ячейка,
        |   Остатки.Организация,
        |   Остатки.Характеристика";
        Запрос.УстановитьПараметр("Номенклатура", ЧастьСсылок);

        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Позиция = ПозицииПоСсылке.Получить(Выборка.Номенклатура);
            Если Позиция = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            Остаток = Новый Структура;
            Остаток.Вставить("organization", Строка(Выборка.Организация));
            Остаток.Вставить("organization_uuid", UUIDЗначения(Выборка.Организация));
            Остаток.Вставить("characteristic", Строка(Выборка.Характеристика));
            Остаток.Вставить("characteristic_uuid", UUIDЗначения(Выборка.Характеристика));
            Остаток.Вставить("warehouse", Строка(Выборка.СтруктурнаяЕдиница));
            Остаток.Вставить("warehouse_uuid", UUIDЗначения(Выборка.СтруктурнаяЕдиница));
            Остаток.Вставить("cell", Строка(Выборка.Ячейка));
            Остаток.Вставить("cell_uuid", UUIDЗначения(Выборка.Ячейка));
            Остаток.Вставить("quantity", Выборка.Количество);
            Позиция.Остатки.Добавить(Остаток);
        КонецЦикла;
        Смещение = Смещение + 500;
    КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьРозничныеЦены(Ссылки, ПозицииПоСсылке)
    Смещение = 0;
    Пока Смещение < Ссылки.Количество() Цикл
        ЧастьСсылок = ЧастьМассива(Ссылки, Смещение, 500);
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |   ЦеныСрез.Номенклатура КАК Номенклатура,
        |   ЦеныСрез.Характеристика КАК Характеристика,
        |   ЦеныСрез.Цена КАК Цена,
        |   ЦеныСрез.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
        |   ЦеныСрез.ВалютаЦены КАК ВалютаЦены
        |ИЗ
        |   РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
        |       , ВидЦен.Наименование = &ВидЦен
        |           И Номенклатура В (&Номенклатура)) КАК ЦеныСрез
        |УПОРЯДОЧИТЬ ПО
        |   ЦеныСрез.Номенклатура,
        |   ЦеныСрез.Характеристика";
        Запрос.УстановитьПараметр("ВидЦен", "Розничная цена");
        Запрос.УстановитьПараметр("Номенклатура", ЧастьСсылок);

        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Позиция = ПозицииПоСсылке.Получить(Выборка.Номенклатура);
            Если Позиция = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            Цена = Новый Структура;
            Цена.Вставить("price_type", "Розничная цена");
            Цена.Вставить("characteristic", Строка(Выборка.Характеристика));
            Цена.Вставить("characteristic_uuid", UUIDЗначения(Выборка.Характеристика));
            Цена.Вставить("price", Выборка.Цена);
            Цена.Вставить("unit", Строка(Выборка.ЕдиницаИзмерения));
            Цена.Вставить("unit_uuid", UUIDЗначения(Выборка.ЕдиницаИзмерения));
            Цена.Вставить("currency", Строка(Выборка.ВалютаЦены));
            Цена.Вставить("currency_uuid", UUIDЗначения(Выборка.ВалютаЦены));
            Позиция.Цены.Добавить(Цена);
        КонецЦикла;
        Смещение = Смещение + 500;
    КонецЦикла;
КонецПроцедуры

Функция СформироватьКовер(Позиция, Отчет)
    ПредупрежденияПозиции = Новый Массив;
    Ковер = Новый Структура;
    Ковер.Вставить("barcode", СокрЛП(Строка(Позиция.Штрихкод)));
    Ковер.Вставить("name", СокрЛП(Строка(Позиция.Наименование)));
    Ковер.Вставить("status", "unknown");
    Ковер.Вставить("category", Позиция.Категория);

    Артикул = СокрЛП(Строка(Позиция.Артикул));
    Если Артикул <> "" И СтрДлина(Артикул) <= 100 Тогда
        Ковер.Вставить("article", Артикул);
    ИначеЕсли СтрДлина(Артикул) > 100 Тогда
        ДобавитьПредупреждение(
            Отчет,
            ПредупрежденияПозиции,
            "article_too_long",
            Позиция,
            "article не передан в прямое поле: длина больше 100 символов");
    КонецЕсли;

    Если ЗначениеЗаполнено(Позиция.Ширина) И Позиция.Ширина > 0 Тогда
        Ковер.Вставить("width_cm", Позиция.Ширина);
    КонецЕсли;
    Если ЗначениеЗаполнено(Позиция.Длина) И Позиция.Длина > 0 Тогда
        Ковер.Вставить("length_cm", Позиция.Длина);
    КонецЕсли;
    Если ЗначениеЗаполнено(Позиция.Вес) И Позиция.Вес >= 0 Тогда
        Ковер.Вставить("weight_kg", Позиция.Вес);
    КонецЕсли;

    Описание = ?(
        ЗначениеЗаполнено(Позиция.Описание),
        Строка(Позиция.Описание),
        Строка(Позиция.Комментарий));
    Если СокрЛП(Описание) <> "" Тогда
        Ковер.Вставить("description", Описание);
    КонецЕсли;

    ДанныеОстатков = СформироватьОстатки(Позиция, Отчет, ПредупрежденияПозиции);
    Ковер.Вставить("stock_qty", ДанныеОстатков.ОбщийОстаток);
    Ковер.Вставить("locations", ДанныеОстатков.ЛокацииBackend);

    ДанныеЦены = ОпределитьРозничнуюЦену(Позиция, Отчет, ПредупрежденияПозиции);
    Если ДанныеЦены.Однозначна Тогда
        Ковер.Вставить("retail_price", ДанныеЦены.Цена);
        Если ДанныеЦены.Единица <> "" И СтрДлина(ДанныеЦены.Единица) <= 50 Тогда
            Ковер.Вставить("retail_price_unit", ДанныеЦены.Единица);
        ИначеЕсли СтрДлина(ДанныеЦены.Единица) > 50 Тогда
            ДобавитьПредупреждение(
                Отчет,
                ПредупрежденияПозиции,
                "retail_price_unit_too_long",
                Позиция,
                "Единица розничной цены сохранена только в raw_payload");
        КонецЕсли;
        Если ДанныеЦены.Валюта <> "" Тогда
            Ковер.Вставить("currency", ДанныеЦены.Валюта);
        КонецЕсли;
    КонецЕсли;

    RawPayload = Новый Структура;
    RawPayload.Вставить("source", "1c");
    RawPayload.Вставить(
        "nomenclature_uuid",
        Строка(Позиция.Ссылка.УникальныйИдентификатор()));
    RawPayload.Вставить("root_group", Позиция.КорневаяГруппа);
    RawPayload.Вставить("category", Позиция.Категория);
    RawPayload.Вставить("article", Строка(Позиция.Артикул));
    RawPayload.Вставить("barcode", Строка(Позиция.Штрихкод));
    RawPayload.Вставить("length", Позиция.Длина);
    RawPayload.Вставить("width", Позиция.Ширина);
    RawPayload.Вставить("weight", Позиция.Вес);
    RawPayload.Вставить("description", Строка(Позиция.Описание));
    RawPayload.Вставить("comment", Строка(Позиция.Комментарий));
    RawPayload.Вставить("stock_register", "РегистрНакопления.ЗапасыНаСкладах.Остатки");
    RawPayload.Вставить("location_rows", Позиция.Остатки);
    RawPayload.Вставить("price_register", "РегистрСведений.ЦеныНоменклатуры.СрезПоследних");
    RawPayload.Вставить("retail_price_rows", Позиция.Цены);
    RawPayload.Вставить("warnings", ПредупрежденияПозиции);
    Ковер.Вставить("raw_payload", RawPayload);
    Возврат Ковер;
КонецФункции

Функция СформироватьОстатки(Позиция, Отчет, ПредупрежденияПозиции)
    Локации = Новый Массив;
    ИндексыЛокаций = Новый Соответствие;
    ОбщийОстаток = 0;

    Для Каждого Остаток Из Позиция.Остатки Цикл
        ОбщийОстаток = ОбщийОстаток + Остаток.quantity;
        Если Остаток.quantity < 0 Тогда
            ДобавитьПредупреждение(
                Отчет,
                ПредупрежденияПозиции,
                "negative_stock_row",
                Позиция,
                "Отрицательная строка остатка сохранена только в raw_payload");
            Продолжить;
        КонецЕсли;
        Если Остаток.quantity = 0 Тогда
            Продолжить;
        КонецЕсли;

        Склад = СокрЛП(Остаток.warehouse);
        Ячейка = СокрЛП(Остаток.cell);
        Если Склад = "" Тогда
            ДобавитьПредупреждение(
                Отчет,
                ПредупрежденияПозиции,
                "empty_warehouse",
                Позиция,
                "Строка location без СтруктурнаяЕдиница сохранена только в raw_payload");
            Продолжить;
        КонецЕсли;
        Если СтрДлина(Склад) > 255 Или СтрДлина(Ячейка) > 255 Тогда
            ДобавитьПредупреждение(
                Отчет,
                ПредупрежденияПозиции,
                "location_too_long",
                Позиция,
                "Строка location длиннее лимита backend сохранена только в raw_payload");
            Продолжить;
        КонецЕсли;

        КлючЛокации = Строка(СтрДлина(Остаток.warehouse_uuid)) + ":"
            + Остаток.warehouse_uuid + Строка(СтрДлина(Склад)) + ":" + Склад
            + Строка(СтрДлина(Остаток.cell_uuid)) + ":" + Остаток.cell_uuid
            + Строка(СтрДлина(Ячейка)) + ":" + Ячейка;
        ИндексЛокации = ИндексыЛокаций.Получить(КлючЛокации);
        Если ИндексЛокации = Неопределено Тогда
            Локация = Новый Структура;
            Локация.Вставить("warehouse", Склад);
            Если Ячейка <> "" Тогда
                Локация.Вставить("cell", Ячейка);
            КонецЕсли;
            Локация.Вставить("qty", Остаток.quantity);
            Локации.Добавить(Локация);
            ИндексЛокации = Локации.Количество() - 1;
            ИндексыЛокаций.Вставить(КлючЛокации, ИндексЛокации);
        Иначе
            Локации[ИндексЛокации].qty =
                Локации[ИндексЛокации].qty + Остаток.quantity;
        КонецЕсли;
    КонецЦикла;

    Если ОбщийОстаток < 0 Тогда
        ДобавитьПредупреждение(
            Отчет,
            ПредупрежденияПозиции,
            "negative_total_stock",
            Позиция,
            "Отрицательный общий остаток приведён к 0 для backend; исходные строки сохранены");
        ОбщийОстаток = 0;
    КонецЕсли;
    Возврат Новый Структура(
        "ОбщийОстаток,ЛокацииBackend",
        ОбщийОстаток,
        Локации);
КонецФункции

Функция ОпределитьРозничнуюЦену(Позиция, Отчет, ПредупрежденияПозиции)
    Если Позиция.Цены.Количество() = 0 Тогда
        Возврат Новый Структура("Однозначна,Цена,Единица,Валюта", Ложь, 0, "", "");
    КонецЕсли;

    Первая = Позиция.Цены[0];
    ЦенаОднозначна = Первая.price >= 0;
    Для Каждого Цена Из Позиция.Цены Цикл
        Если Цена.price < 0
            Или Цена.price <> Первая.price
            Или Цена.unit <> Первая.unit
            Или Цена.currency <> Первая.currency Тогда
            ЦенаОднозначна = Ложь;
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Если Не ЦенаОднозначна Тогда
        ДобавитьПредупреждение(
            Отчет,
            ПредупрежденияПозиции,
            "multiple_retail_prices",
            Позиция,
            "Розничная цена неоднозначна по характеристикам и сохранена только в raw_payload");
        Возврат Новый Структура("Однозначна,Цена,Единица,Валюта", Ложь, 0, "", "");
    КонецЕсли;

    Валюта = НормализоватьВалюту(Первая.currency);
    Если Валюта = Неопределено Тогда
        ДобавитьПредупреждение(
            Отчет,
            ПредупрежденияПозиции,
            "unknown_retail_currency",
            Позиция,
            "Валюта розничной цены не сопоставлена; цена сохранена только в raw_payload");
        Возврат Новый Структура("Однозначна,Цена,Единица,Валюта", Ложь, 0, "", "");
    КонецЕсли;

    Возврат Новый Структура(
        "Однозначна,Цена,Единица,Валюта",
        Истина,
        Первая.price,
        СокрЛП(Первая.unit),
        Валюта);
КонецФункции

Функция НормализоватьВалюту(ПредставлениеВалюты)
    Значение = ВРег(СокрЛП(Строка(ПредставлениеВалюты)));
    Если Значение = "" Или Найти(Значение, "РУБ") > 0 Или Значение = "RUB" Тогда
        Возврат "RUB";
    КонецЕсли;
    Если Значение = "USD" Или Значение = "EUR" Тогда
        Возврат Значение;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

Процедура ДобавитьПроблему(Проблемы, Код, Позиция, Сообщение)
    Проблема = Новый Структура;
    Проблема.Вставить("code", Код);
    Проблема.Вставить(
        "nomenclature_uuid",
        Строка(Позиция.Ссылка.УникальныйИдентификатор()));
    Проблема.Вставить("barcode", Строка(Позиция.Штрихкод));
    Проблема.Вставить("name", Строка(Позиция.Наименование));
    Проблема.Вставить("message", Сообщение);
    Проблемы.Добавить(Проблема);
КонецПроцедуры

Процедура ДобавитьПредупреждение(
    Отчет,
    ПредупрежденияПозиции,
    Код,
    Позиция,
    Сообщение)

    ПредупрежденияПозиции.Добавить(Код);
    ДобавитьПроблему(Отчет.warnings, Код, Позиция, Сообщение);
КонецПроцедуры

Функция UUIDЗначения(Значение)
    Если Не ЗначениеЗаполнено(Значение) Тогда
        Возврат "";
    КонецЕсли;
    Попытка
        Возврат Строка(Значение.УникальныйИдентификатор());
    Исключение
        Возврат "";
    КонецПопытки;
КонецФункции

Функция ЧастьМассива(ИсходныйМассив, Смещение, Размер)
    Результат = Новый Массив;
    ПоследнийИндекс = Смещение + Размер - 1;
    Если ПоследнийИндекс >= ИсходныйМассив.Количество() Тогда
        ПоследнийИндекс = ИсходныйМассив.Количество() - 1;
    КонецЕсли;
    Для Индекс = Смещение По ПоследнийИндекс Цикл
        Результат.Добавить(ИсходныйМассив[Индекс]);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ИзвлечьНачалоМассива(ИсходныйМассив, Размер)
    Результат = Новый Массив;
    Количество = ?(ИсходныйМассив.Количество() < Размер, ИсходныйМассив.Количество(), Размер);
    Для Индекс = 1 По Количество Цикл
        Результат.Добавить(ИсходныйМассив[0]);
        ИсходныйМассив.Удалить(0);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ПрочитатьОтветBackend(ОтветHTTP)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ОтветHTTP.ПолучитьТелоКакСтроку());
    Возврат ПрочитатьJSON(Чтение);
КонецФункции

Функция ОшибкиПакета(ОтветПакета)
    Результат = Новый Массив;
    Для Каждого Элемент Из ОтветПакета.items Цикл
        Если Элемент.status = "failed" Тогда
            Ошибка = Новый Структура;
            Ошибка.Вставить("entity_type", Элемент.entity_type);
            Ошибка.Вставить("source_key", Элемент.source_key);
            Ошибка.Вставить("error_code", Элемент.error_code);
            Результат.Добавить(Ошибка);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции
