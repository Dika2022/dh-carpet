// Обработчики подписок ПослеЗаписи документов продаж и возвратов.
// Ни одно исключение интеграции не выходит в транзакцию записи документа 1С.

Процедура РасходнаяНакладнаяПослеЗаписи(Источник) Экспорт
    Попытка
        Настройки = ДХКоверНастройкиСервер.ПолучитьПараметрыПодключения();
        Пакет = ДХКоверПродажиСервер.СформироватьПакетПродажи(
            Источник.Ссылка,
            Настройки.СмещениеЧасовогоПояса);
        ДХКоверТранспортСервер.ОтправитьПакетDhCarpetБезопасно(
            Настройки.АдресСервера,
            Настройки.КлючAPI,
            Пакет,
            Источник.Ссылка);
    Исключение
        ДХКоверТранспортСервер.БезопасноЗаписатьОшибкуСинхронизации(
            Источник.Ссылка,
            ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Процедура ПриходнаяНакладнаяПослеЗаписи(Источник) Экспорт
    Попытка
        Настройки = ДХКоверНастройкиСервер.ПолучитьПараметрыПодключения();
        Пакет = ДХКоверВозвратыСервер.СформироватьПакетВозвратаПокупателя(
            Источник.Ссылка,
            Настройки.СмещениеЧасовогоПояса);
        ДХКоверТранспортСервер.ОтправитьПакетDhCarpetБезопасно(
            Настройки.АдресСервера,
            Настройки.КлючAPI,
            Пакет,
            Источник.Ссылка);
    Исключение
        ДХКоверТранспортСервер.БезопасноЗаписатьОшибкуСинхронизации(
            Источник.Ссылка,
            ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры
