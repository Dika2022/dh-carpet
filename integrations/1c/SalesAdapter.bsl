// READ ONLY адаптер полного snapshot продажи.
// Код предназначен для серверного общего модуля расширения 1С.

Функция СформироватьПакетПродажи(СсылкаДокумента, СмещениеЧасовогоПояса) Экспорт
    Если ТипЗнч(СсылкаДокумента) <> Тип("ДокументСсылка.РасходнаяНакладная") Тогда
        ВызватьИсключение "Ожидалась ссылка Документ.РасходнаяНакладная";
    КонецЕсли;

    UUIDДокумента = Строка(СсылкаДокумента.УникальныйИдентификатор());
    ЭтоПродажа = СсылкаДокумента.Проведен
        И СсылкаДокумента.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю;

    События = Новый Массив;
    КлючиСтрок = Новый Массив;
    Если ЭтоПродажа Тогда
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |   Запасы.Номенклатура КАК Номенклатура,
        |   Запасы.Номенклатура.Штрихкод КАК Штрихкод,
        |   Запасы.Номенклатура.Артикул КАК Артикул,
        |   Запасы.Цена КАК Цена,
        |   Запасы.Количество КАК Количество,
        |   Запасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
        |   Запасы.ИдентификаторСтроки КАК ИдентификаторСтроки
        |ИЗ
        |   Документ.РасходнаяНакладная.Запасы КАК Запасы
        |ГДЕ
        |   Запасы.Ссылка = &Ссылка";
        Запрос.УстановитьПараметр("Ссылка", СсылкаДокумента);

        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            ПроверитьКлючевыеПоляПродажи(Выборка, UUIDДокумента);
            КлючСтроки = Строка(Выборка.ИдентификаторСтроки);
            КлючиСтрок.Добавить(КлючСтроки);

            Payload = Новый Структура;
            Payload.Вставить("document_uuid", UUIDДокумента);
            Payload.Вставить("line_id", КлючСтроки);
            Payload.Вставить("nomenclature_uuid", Строка(Выборка.Номенклатура.УникальныйИдентификатор()));
            Payload.Вставить("nomenclature", Строка(Выборка.Номенклатура));
            Payload.Вставить("article", Выборка.Артикул);
            Payload.Вставить("barcode", Выборка.Штрихкод);
            Payload.Вставить("posted", Истина);

            Событие = Новый Структура;
            Событие.Вставить("barcode", Выборка.Штрихкод);
            Событие.Вставить("event_type", "sale");
            Событие.Вставить("event_at", Формат(СсылкаДокумента.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss") + СмещениеЧасовогоПояса);
            Событие.Вставить("price", Выборка.Цена);
            Событие.Вставить("qty", Выборка.Количество);
            Событие.Вставить("unit", Строка(Выборка.ЕдиницаИзмерения));
            Событие.Вставить("counterparty", Строка(СсылкаДокумента.Контрагент));
            Событие.Вставить("source_ref", UUIDДокумента);
            Событие.Вставить("source_line_key", КлючСтроки);
            Событие.Вставить("posted", Истина);
            Событие.Вставить("payload", Payload);
            События.Добавить(Событие);
        КонецЦикла;
    КонецЕсли;

    Snapshot = Новый Структура;
    Snapshot.Вставить("event_type", "sale");
    Snapshot.Вставить("source_ref", UUIDДокумента);
    Snapshot.Вставить("posted", ЭтоПродажа);
    Snapshot.Вставить("line_keys", КлючиСтрок);

    Пакет = Новый Структура;
    Пакет.Вставить("mode", "incremental");
    Пакет.Вставить("rugs", Новый Массив);
    Пакет.Вставить("events", События);
    Snapshots = Новый Массив;
    Snapshots.Добавить(Snapshot);
    Пакет.Вставить("document_snapshots", Snapshots);
    Возврат Пакет;
КонецФункции

Процедура ПроверитьКлючевыеПоляПродажи(СтрокаЗапасов, UUIDДокумента)
    Если Не ЗначениеЗаполнено(СтрокаЗапасов.ИдентификаторСтроки) Тогда
        ВызватьИсключение "Не заполнен ИдентификаторСтроки в расходной накладной " + UUIDДокумента;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(СтрокаЗапасов.Штрихкод) Тогда
        ВызватьИсключение "Не заполнен Штрихкод номенклатуры в расходной накладной " + UUIDДокумента;
    КонецЕсли;
КонецПроцедуры
