// Модуль общей формы ДХКоверПервоначальнаяВыгрузкаКаталога.
// API key используется только внутри серверного вызова и не возвращается на клиент.

&НаКлиенте
Процедура ВыполнитьВыгрузку(Команда)
    Ответ = Вопрос(
        "Выполнить первоначальную выгрузку каталога в dh-carpet?",
        РежимДиалогаВопрос.ДаНет);
    Если Ответ <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    РезультатВыгрузки = "Выгрузка выполняется...";
    Попытка
        РезультатВыгрузки = ВыполнитьВыгрузкуНаСервере();
        Сообщить("Первоначальная выгрузка завершена. Проверьте JSON-отчёт на форме.");
    Исключение
        РезультатВыгрузки = "Ошибка первоначальной выгрузки: " + ОписаниеОшибки();
        Сообщить(РезультатВыгрузки);
    КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыполнитьВыгрузкуНаСервере()
    Настройки = ДХКоверНастройкиСервер.ПолучитьПараметрыПодключения();
    Отчет = ДХКоверКаталогСервер.ВыполнитьПервоначальнуюВыгрузку(
        Настройки.АдресСервера,
        Настройки.КлючAPI);

    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Отчет);
    Возврат Запись.Закрыть();
КонецФункции
