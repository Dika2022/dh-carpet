// Серверный доступ к общим защищённым настройкам интеграции.
// Реальные адрес и API key хранятся в безопасном хранилище БСП, а не в коде.

Функция ПолучитьПараметрыПодключения() Экспорт
    Данные = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
        "dh-carpet.integration",
        "АдресСервера,КлючAPI",
        Истина);

    АдресСервера = Неопределено;
    КлючAPI = Неопределено;
    Если Данные = Неопределено
        Или Не Данные.Свойство("АдресСервера", АдресСервера)
        Или Не Данные.Свойство("КлючAPI", КлючAPI)
        Или Не ЗначениеЗаполнено(АдресСервера)
        Или Не ЗначениеЗаполнено(КлючAPI) Тогда
        ВызватьИсключение "Не настроены защищённые параметры интеграции dh-carpet";
    КонецЕсли;

    Возврат Новый Структура(
        "АдресСервера,КлючAPI,СмещениеЧасовогоПояса",
        АдресСервера,
        КлючAPI,
        "+03:00");
КонецФункции

Процедура СохранитьПараметрыПодключения(АдресСервера, КлючAPI) Экспорт
    Если Не ЗначениеЗаполнено(АдресСервера) Или Не ЗначениеЗаполнено(КлючAPI) Тогда
        ВызватьИсключение "Адрес сервера и API key должны быть заполнены";
    КонецЕсли;

    ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
        "dh-carpet.integration", АдресСервера, "АдресСервера", Истина);
    ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
        "dh-carpet.integration", КлючAPI, "КлючAPI", Истина);
КонецПроцедуры
