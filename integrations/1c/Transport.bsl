// Общий модуль отдельной интеграции dh-carpet.
// Адрес и ключ поступают из защищённых настроек расширения, а не из исходного кода.

Функция ОтправитьПакетDhCarpet(АдресСервера, КлючAPI, ДанныеПакета, ТаймаутСекунд = 10) Экспорт
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеПакета);
    ТелоЗапроса = ЗаписьJSON.Закрыть();

    URI = Новый URI(АдресСервера);
    Соединение = Новый HTTPСоединение(
        URI.Хост, URI.Порт, , , , ТаймаутСекунд,
        Новый ЗащищенноеСоединениеOpenSSL());
    Запрос = Новый HTTPЗапрос("/api/internal/1c/bulk");
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.Заголовки.Вставить("X-Internal-API-Key", КлючAPI);
    Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
    Возврат Соединение.ОтправитьДляОбработки(Запрос);
КонецФункции

Функция ОтправитьПакетDhCarpetБезопасно(АдресСервера, КлючAPI, ДанныеПакета, Источник) Экспорт
    Попытка
        Ответ = ОтправитьПакетDhCarpet(АдресСервера, КлючAPI, ДанныеПакета, 10);
        Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
            ВызватьИсключение "dh-carpet вернул HTTP " + Строка(Ответ.КодСостояния);
        КонецЕсли;
        Возврат Истина;
    Исключение
        БезопасноЗаписатьОшибкуСинхронизации(Источник, ОписаниеОшибки());
        Возврат Ложь;
    КонецПопытки;
КонецФункции

Процедура БезопасноЗаписатьОшибкуСинхронизации(Источник, ТекстОшибки) Экспорт
    // Ошибка журнала регистрации также не должна прерывать запись документа.
    Попытка
        ЗаписьЖурналаРегистрации(
            "dh-carpet.Синхронизация1С",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Источник " + Строка(Источник) + ": " + ТекстОшибки);
    Исключение
    КонецПопытки;
КонецПроцедуры
