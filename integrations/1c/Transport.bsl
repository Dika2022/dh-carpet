// Общий модуль отдельной интеграции dh-carpet.
// Адрес и ключ поступают из защищённых настроек расширения, а не из исходного кода.

Функция ОтправитьПакетDhCarpet(АдресСервера, КлючAPI, ДанныеПакета, ТаймаутСекунд = 10) Экспорт
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеПакета);
    ТелоЗапроса = ЗаписьJSON.Закрыть();

    ПараметрыАдреса = РазобратьАдресСервера(АдресСервера);
    Если ПараметрыАдреса.ИспользоватьHTTPS Тогда
        Соединение = Новый HTTPСоединение(
            ПараметрыАдреса.Хост,
            ПараметрыАдреса.Порт,
            , , , ТаймаутСекунд,
            Новый ЗащищенноеСоединениеOpenSSL());
    Иначе
        Соединение = Новый HTTPСоединение(
            ПараметрыАдреса.Хост,
            ПараметрыАдреса.Порт,
            , , , ТаймаутСекунд);
    КонецЕсли;

    ПутьЗапроса = ПараметрыАдреса.БазовыйПуть + "/api/internal/1c/bulk";
    Запрос = Новый HTTPЗапрос(ПутьЗапроса);
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.Заголовки.Вставить("X-Internal-API-Key", КлючAPI);
    Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
    Возврат Соединение.ОтправитьДляОбработки(Запрос);
КонецФункции

Функция РазобратьАдресСервера(АдресСервера)
    Адрес = СокрЛП(Строка(АдресСервера));
    Если Адрес = "" Тогда
        ВызватьИсключение "Не указан адрес сервера dh-carpet";
    КонецЕсли;

    Если НРег(Лев(Адрес, 8)) = "https://" Тогда
        ИспользоватьHTTPS = Истина;
        ПортПоУмолчанию = 443;
        АдресБезСхемы = Сред(Адрес, 9);
    ИначеЕсли НРег(Лев(Адрес, 7)) = "http://" Тогда
        ИспользоватьHTTPS = Ложь;
        ПортПоУмолчанию = 80;
        АдресБезСхемы = Сред(Адрес, 8);
    Иначе
        ВызватьИсключение "Адрес сервера dh-carpet должен начинаться с http:// или https://";
    КонецЕсли;

    Если Найти(АдресБезСхемы, "?") > 0 Или Найти(АдресБезСхемы, "#") > 0 Тогда
        ВызватьИсключение "Адрес сервера dh-carpet не должен содержать параметры запроса или фрагмент";
    КонецЕсли;

    ПозицияСлеша = Найти(АдресБезСхемы, "/");
    Если ПозицияСлеша = 0 Тогда
        УзелИПорт = АдресБезСхемы;
        БазовыйПуть = "";
    Иначе
        УзелИПорт = Лев(АдресБезСхемы, ПозицияСлеша - 1);
        БазовыйПуть = Сред(АдресБезСхемы, ПозицияСлеша);
    КонецЕсли;

    Пока СтрДлина(БазовыйПуть) > 0 И Прав(БазовыйПуть, 1) = "/" Цикл
        БазовыйПуть = Лев(БазовыйПуть, СтрДлина(БазовыйПуть) - 1);
    КонецЦикла;

    Хост = "";
    СтрокаПорта = "";
    Если Лев(УзелИПорт, 1) = "[" Тогда
        // IPv6 записывается в URL в квадратных скобках: https://[2001:db8::1]:8443.
        ПозицияСкобки = Найти(УзелИПорт, "]");
        Если ПозицияСкобки = 0 Тогда
            ВызватьИсключение "Некорректный IPv6-адрес сервера dh-carpet";
        КонецЕсли;

        Хост = Сред(УзелИПорт, 2, ПозицияСкобки - 2);
        ОстатокУзла = Сред(УзелИПорт, ПозицияСкобки + 1);
        Если ОстатокУзла <> "" Тогда
            Если Лев(ОстатокУзла, 1) <> ":" Тогда
                ВызватьИсключение "После IPv6-адреса сервера dh-carpet указан некорректный порт";
            КонецЕсли;
            СтрокаПорта = Сред(ОстатокУзла, 2);
        КонецЕсли;
    Иначе
        ПозицияДвоеточия = Найти(УзелИПорт, ":");
        Если ПозицияДвоеточия = 0 Тогда
            Хост = УзелИПорт;
        Иначе
            Хост = Лев(УзелИПорт, ПозицияДвоеточия - 1);
            СтрокаПорта = Сред(УзелИПорт, ПозицияДвоеточия + 1);
            Если Найти(СтрокаПорта, ":") > 0 Тогда
                ВызватьИсключение "IPv6-адрес сервера dh-carpet должен быть заключен в квадратные скобки";
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;

    Если Хост = "" Тогда
        ВызватьИсключение "Не указан hostname или IP сервера dh-carpet";
    КонецЕсли;

    Если СтрокаПорта = "" Тогда
        Порт = ПортПоУмолчанию;
    Иначе
        Попытка
            Порт = Число(СтрокаПорта);
        Исключение
            ВызватьИсключение "Некорректный порт сервера dh-carpet";
        КонецПопытки;
        Если Порт <> Цел(Порт) Или Порт < 1 Или Порт > 65535 Тогда
            ВызватьИсключение "Порт сервера dh-carpet должен быть целым числом от 1 до 65535";
        КонецЕсли;
    КонецЕсли;

    Возврат Новый Структура(
        "Хост,Порт,ИспользоватьHTTPS,БазовыйПуть",
        Хост,
        Порт,
        ИспользоватьHTTPS,
        БазовыйПуть);
КонецФункции

Функция ОтправитьПакетDhCarpetБезопасно(АдресСервера, КлючAPI, ДанныеПакета, Источник) Экспорт
    Попытка
        Ответ = ОтправитьПакетDhCarpet(АдресСервера, КлючAPI, ДанныеПакета, 10);
        Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
            ВызватьИсключение "dh-carpet вернул HTTP " + Строка(Ответ.КодСостояния);
        КонецЕсли;
        Возврат Истина;
    Исключение
        БезопасноЗаписатьОшибкуСинхронизации(Источник, ОписаниеОшибки());
        Возврат Ложь;
    КонецПопытки;
КонецФункции

Процедура БезопасноЗаписатьОшибкуСинхронизации(Источник, ТекстОшибки) Экспорт
    // Ошибка журнала регистрации также не должна прерывать запись документа.
    Попытка
        ЗаписьЖурналаРегистрации(
            "dh-carpet.Синхронизация1С",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Источник " + Строка(Источник) + ": " + ТекстОшибки);
    Исключение
    КонецПопытки;
КонецПроцедуры
