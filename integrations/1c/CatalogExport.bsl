// Запрос использует только подтверждённые технические имена.
// Остатки, цены, дополнительные реквизиты, locations и файлы дополняются
// отдельными адаптерами после проверки metadata конкретной конфигурации.

Функция ПрочитатьНоменклатуруКорневойГруппы(КорневаяГруппа) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Номенклатура.Ссылка КАК Ссылка,
    |   Номенклатура.Наименование КАК Наименование,
    |   Номенклатура.Артикул КАК Артикул,
    |   Номенклатура.Штрихкод КАК Штрихкод,
    |   Номенклатура.Длина КАК Длина,
    |   Номенклатура.Ширина КАК Ширина,
    |   Номенклатура.Вес КАК Вес,
    |   Номенклатура.Описание КАК Описание,
    |   Номенклатура.Комментарий КАК Комментарий
    |ИЗ
    |   Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |   Номенклатура.Ссылка В ИЕРАРХИИ(&КорневаяГруппа)
    |   И НЕ Номенклатура.ЭтоГруппа
    |   И НЕ Номенклатура.ПометкаУдаления";
    Запрос.УстановитьПараметр("КорневаяГруппа", КорневаяГруппа);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ОписаниеНоменклатуры(СтрокаНоменклатуры) Экспорт
    Если ЗначениеЗаполнено(СтрокаНоменклатуры.Описание) Тогда
        Возврат СтрокаНоменклатуры.Описание;
    КонецЕсли;
    Возврат СтрокаНоменклатуры.Комментарий;
КонецФункции
