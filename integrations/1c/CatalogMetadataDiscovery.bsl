// READ ONLY диагностика metadata каталога для dh-carpet.
// Код предназначен для модуля управляемой формы временной внешней обработки.
// На форме нужны строковый реквизит РезультатДиагностики неограниченной длины
// и команда ВыполнитьДиагностику.
//
// Диагностика не записывает данные и не перебирает товары. Из базы читаются
// только группы номенклатуры с четырьмя заданными наименованиями (не более 50).

&НаКлиенте
Процедура ВыполнитьДиагностику(Команда)
    РезультатДиагностики = ВыполнитьДиагностикуНаСервере();
    Сообщить("Готово. Скопируйте весь JSON из поля РезультатДиагностики.");
КонецПроцедуры

&НаСервере
Функция ВыполнитьДиагностикуНаСервере()
    Отчет = Новый Структура;
    Отчет.Вставить("diagnostic", "dh-carpet-1c-catalog-metadata-discovery");
    Отчет.Вставить("version", 1);
    Отчет.Вставить("generated_at", Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
    Отчет.Вставить("read_only", Истина);
    Отчет.Вставить("nomenclature_catalog", ОписаниеНоменклатуры());
    Отчет.Вставить("stock_register", ОписаниеРегистраНакопления("Запасы"));
    Отчет.Вставить("price_register", ОписаниеРегистраСведений("ЦеныНоменклатуры"));
    Отчет.Вставить("target_retail_price_name", "Розничная цена");
    Отчет.Вставить("root_group_matches", НайтиЦелевыеГруппы());

    НеобходимыеПоля = Новый Массив;
    НеобходимыеПоля.Добавить("stock_register: имя измерения номенклатуры");
    НеобходимыеПоля.Добавить("stock_register: имя ресурса количества/остатка");
    НеобходимыеПоля.Добавить("stock_register: имена измерений склада, ячейки и единицы, если они есть");
    НеобходимыеПоля.Добавить("price_register: имя измерения номенклатуры");
    НеобходимыеПоля.Добавить("price_register: имя измерения вида цены и тип его ссылки");
    НеобходимыеПоля.Добавить("price_register: имя ресурса цены");
    НеобходимыеПоля.Добавить("price_register: периодичность и имена единицы/валюты, если они есть");
    Отчет.Вставить("fields_required_before_adapter", НеобходимыеПоля);

    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Отчет);
    Возврат Запись.Закрыть();
КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеНоменклатуры()
    Результат = Новый Структура;
    Результат.Вставить("metadata_name", "Справочник.Номенклатура");
    Результат.Вставить("found", Истина);
    Результат.Вставить("stable_id", "Ссылка.УникальныйИдентификатор()");
    Поля = Новый Массив;
    Поля.Добавить("Наименование");
    Поля.Добавить("Артикул");
    Поля.Добавить("Штрихкод");
    Поля.Добавить("Длина");
    Поля.Добавить("Ширина");
    Поля.Добавить("Вес");
    Поля.Добавить("Описание");
    Поля.Добавить("Комментарий");
    Поля.Добавить("ПометкаУдаления");
    Поля.Добавить("ЭтоГруппа");
    Результат.Вставить("confirmed_fields", Поля);
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеРегистраНакопления(ИмяРегистра)
    Для Каждого Регистр Из Метаданные.РегистрыНакопления Цикл
        Если Регистр.Имя = ИмяРегистра Тогда
            Возврат ОписаниеРегистра(Регистр);
        КонецЕсли;
    КонецЦикла;
    Возврат НеНайден(ИмяРегистра);
КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеРегистраСведений(ИмяРегистра)
    Для Каждого Регистр Из Метаданные.РегистрыСведений Цикл
        Если Регистр.Имя = ИмяРегистра Тогда
            Результат = ОписаниеРегистра(Регистр);
            Результат.Вставить("periodicity", Строка(Регистр.Периодичность));
            Возврат Результат;
        КонецЕсли;
    КонецЦикла;
    Возврат НеНайден(ИмяРегистра);
КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеРегистра(Регистр)
    Результат = Новый Структура;
    Результат.Вставить("metadata_name", Регистр.ПолноеИмя());
    Результат.Вставить("synonym", Строка(Регистр.Синоним));
    Результат.Вставить("found", Истина);
    Результат.Вставить("dimensions", ОписаниеПолей(Регистр.Измерения));
    Результат.Вставить("resources", ОписаниеПолей(Регистр.Ресурсы));
    Результат.Вставить("attributes", ОписаниеПолей(Регистр.Реквизиты));
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеПолей(Поля)
    Результат = Новый Массив;
    Для Каждого Поле Из Поля Цикл
        Описание = Новый Структура;
        Описание.Вставить("name", Поле.Имя);
        Описание.Вставить("synonym", Строка(Поле.Синоним));
        Описание.Вставить("type", Строка(Поле.Тип));
        Результат.Добавить(Описание);
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция НеНайден(ИмяОбъекта)
    Результат = Новый Структура;
    Результат.Вставить("metadata_name", ИмяОбъекта);
    Результат.Вставить("found", Ложь);
    Результат.Вставить("do_not_assume", Истина);
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиЦелевыеГруппы()
    Имена = Новый Массив;
    Имена.Добавить("Ковры");
    Имена.Добавить("Ковролины");
    Имена.Добавить("Ковролины (в т.ч. дорожки)");
    Имена.Добавить("Шкуры");

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 50
    |   Номенклатура.Ссылка КАК Ссылка,
    |   Номенклатура.Наименование КАК Наименование,
    |   Номенклатура.Родитель КАК Родитель,
    |   Номенклатура.ПометкаУдаления КАК ПометкаУдаления
    |ИЗ
    |   Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |   Номенклатура.ЭтоГруппа
    |   И Номенклатура.Наименование В (&Имена)";
    Запрос.УстановитьПараметр("Имена", Имена);

    Результат = Новый Массив;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Группа = Новый Структура;
        Группа.Вставить("name", Выборка.Наименование);
        Группа.Вставить("uuid", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
        Группа.Вставить("parent", Строка(Выборка.Родитель));
        Группа.Вставить("deletion_mark", Выборка.ПометкаУдаления);
        Результат.Добавить(Группа);
    КонецЦикла;
    Возврат Результат;
КонецФункции
