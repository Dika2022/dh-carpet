// Регистрация MetadataDiscovery.epf в подсистеме БСП
// «Дополнительные отчеты и обработки».
//
// Код не запрашивает доступ к внешним ресурсам и оставляет обработку
// в безопасном режиме. Диагностика выполняется в модуле основной формы.

Функция СведенияОВнешнейОбработке() Экспорт
    Сведения = Новый Структура;
    Сведения.Вставить("Вид", "ДополнительнаяОбработка");
    Сведения.Вставить("Назначение", Новый Массив);
    Сведения.Вставить("Наименование", "Диагностика метаданных 1С для dh-carpet");
    Сведения.Вставить("Версия", "1.0.0");
    Сведения.Вставить("БезопасныйРежим", Истина);
    Сведения.Вставить("Информация", "READ ONLY: определение структуры документов для интеграции dh-carpet.");

    Команды = Новый ТаблицаЗначений;
    Команды.Колонки.Добавить("Представление");
    Команды.Колонки.Добавить("Идентификатор");
    Команды.Колонки.Добавить("Использование");
    Команды.Колонки.Добавить("ПоказыватьОповещение");
    Команды.Колонки.Добавить("Модификатор");

    Команда = Команды.Добавить();
    Команда.Представление = "Открыть диагностику метаданных";
    Команда.Идентификатор = "ОткрытьФормуДиагностики";
    Команда.Использование = "ОткрытиеФормы";
    Команда.ПоказыватьОповещение = Ложь;
    Команда.Модификатор = "";

    Сведения.Вставить("Команды", Команды);
    Возврат Сведения;
КонецФункции
