// READ ONLY metadata discovery для dh-carpet.
// Вставить в модуль управляемой формы временной внешней обработки.
// На форме создать строковый реквизит РезультатДиагностики неограниченной
// длины и команду ВыполнитьДиагностику с обработчиком ниже.
//
// Код не записывает данные, не получает объекты документов, не проводит
// документы и не меняет конфигурацию. Для кандидата читаются не более пяти
// последних документов; структура определяется преимущественно по metadata.

&НаКлиенте
Процедура ВыполнитьДиагностику(Команда)
    РезультатДиагностики = ВыполнитьДиагностикуНаСервере();
    Сообщить("Готово. Скопируйте весь JSON из поля РезультатДиагностики.");
КонецПроцедуры

&НаСервере
Функция ВыполнитьДиагностикуНаСервере()
    Отчет = Новый Структура;
    Отчет.Вставить("diagnostic", "dh-carpet-1c-metadata-discovery");
    Отчет.Вставить("version", 2);
    Отчет.Вставить("generated_at", Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
    Отчет.Вставить("read_only", Истина);
    Отчет.Вставить("document_external_id", "Ссылка.УникальныйИдентификатор() — стабильный UUID ссылки в пределах этой базы 1С");
    Отчет.Вставить("line_key_policy", ОписаниеПолитикиКлючаСтроки());
    Отчет.Вставить("expense_documents", НайтиДокументы("expense"));
    Отчет.Вставить("receipt_documents", НайтиДокументы("receipt"));

    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Отчет);
    Возврат Запись.Закрыть();
КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеПолитикиКлючаСтроки()
    Возврат "Если metadata не содержит отдельного ID строки: UUID документа + metadata name табличной части + fingerprint нормализованных Номенклатура/Цена/Количество/Единица + номер в группе полностью одинаковых строк. При изменении или распроведении передается полный snapshot документа, отсутствующие прежние ключи закрываются.";
КонецФункции

&НаСервереБезКонтекста
Функция НайтиДокументы(Назначение)
    Результат = Новый Структура;
    Результат.Вставить("target", ?(Назначение = "expense", "Расходная накладная", "Приходная накладная"));
    Точные = Новый Массив;
    Возможные = Новый Массив;

    Для Каждого Документ Из Метаданные.Документы Цикл
        Поиск = Нормализовать(Документ.Имя + " " + Строка(Документ.Синоним));
        Если Назначение = "expense" Тогда
            ТочноеСовпадение = СтрНайти(Поиск, "расход") > 0 И СтрНайти(Поиск, "наклад") > 0;
            ВозможноеСовпадение = СтрНайти(Поиск, "расход") > 0 Или СтрНайти(Поиск, "реализац") > 0;
        Иначе
            ТочноеСовпадение = СтрНайти(Поиск, "приход") > 0 И СтрНайти(Поиск, "наклад") > 0;
            ВозможноеСовпадение = СтрНайти(Поиск, "приход") > 0
                Или СтрНайти(Поиск, "возврат") > 0
                Или СтрНайти(Поиск, "поступлен") > 0;
        КонецЕсли;
        Если ТочноеСовпадение Тогда
            Точные.Добавить(ОписаниеДокумента(Документ, Истина));
        ИначеЕсли ВозможноеСовпадение Тогда
            Возможные.Добавить(ОписаниеДокумента(Документ, Ложь));
        КонецЕсли;
    КонецЦикла;

    Статус = ?(Точные.Количество() = 1, "exact_single_match",
        ?(Точные.Количество() > 1, "multiple_exact_matches", "exact_match_not_found"));
    Результат.Вставить("status", Статус);
    Результат.Вставить("exact_matches", Точные);
    Результат.Вставить("fallback_candidates_do_not_assume", Возможные);
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеДокумента(Документ, ЧитатьПримеры)
    Результат = Новый Структура;
    Результат.Вставить("metadata_name", Документ.Имя);
    Результат.Вставить("full_metadata_name", Документ.ПолноеИмя());
    Результат.Вставить("synonym", Строка(Документ.Синоним));
    Результат.Вставить("stable_document_id", "Ссылка.УникальныйИдентификатор()");

    Реквизиты = Новый Массив;
    Для Каждого Реквизит Из Документ.Реквизиты Цикл
        Реквизиты.Добавить(ОписаниеПоля(Реквизит));
    КонецЦикла;
    Результат.Вставить("document_attributes", Реквизиты);
    Результат.Вставить("counterparty_candidates", НайтиПоля(Документ.Реквизиты, "контрагент,покупател,клиент"));
    ПоляОперации = НайтиПоля(Документ.Реквизиты, "операц,видоперац");
    Результат.Вставить("operation_candidates", ПоляОперации);
    Результат.Вставить("operation_enum_values", ЗначенияПеречисленийПоля(Документ.Реквизиты, ПоляОперации));

    ТабличныеЧасти = Новый Массив;
    Для Каждого ТабличнаяЧасть Из Документ.ТабличныеЧасти Цикл
        ТабличныеЧасти.Добавить(ОписаниеТабличнойЧасти(ТабличнаяЧасть));
    КонецЦикла;
    Результат.Вставить("table_parts", ТабличныеЧасти);
    Если ЧитатьПримеры Тогда
        Результат.Вставить("sample_documents_max_5", ПримерыДокументов(Документ.Имя, ЕдинственноеИмя(ПоляОперации)));
    Иначе
        Результат.Вставить("sample_documents_max_5", "not_read_for_fallback_candidate");
    КонецЕсли;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеТабличнойЧасти(ТабличнаяЧасть)
    Результат = Новый Структура;
    Результат.Вставить("metadata_name", ТабличнаяЧасть.Имя);
    Результат.Вставить("synonym", Строка(ТабличнаяЧасть.Синоним));
    Колонки = Новый Массив;
    Для Каждого Колонка Из ТабличнаяЧасть.Реквизиты Цикл
        Колонки.Добавить(ОписаниеПоля(Колонка));
    КонецЦикла;
    Результат.Вставить("columns", Колонки);
    Результат.Вставить("nomenclature_candidates", НайтиПоля(ТабличнаяЧасть.Реквизиты, "номенклатур,товар"));
    Результат.Вставить("price_candidates", НайтиПоля(ТабличнаяЧасть.Реквизиты, "цена"));
    Результат.Вставить("quantity_candidates", НайтиПоля(ТабличнаяЧасть.Реквизиты, "количеств"));
    Результат.Вставить("unit_candidates", НайтиПоля(ТабличнаяЧасть.Реквизиты, "единиц,едизм,единицаизмерения"));
    Результат.Вставить("line_id_candidates", НайтиПоля(ТабличнаяЧасть.Реквизиты, "идентификаторстрок,idстрок,uuidстрок,ключстрок"));
    Результат.Вставить("standard_row_number", "НомерСтроки доступен в запросе, но не устойчив при перестановке строк");
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеПоля(Поле)
    Результат = Новый Структура;
    Результат.Вставить("metadata_name", Поле.Имя);
    Результат.Вставить("synonym", Строка(Поле.Синоним));
    Результат.Вставить("type", Строка(Поле.Тип));
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиПоля(КоллекцияПолей, СтрокаКлючевыхСлов)
    КлючевыеСлова = СтрРазделить(СтрокаКлючевыхСлов, ",", Ложь);
    Результат = Новый Массив;
    Для Каждого Поле Из КоллекцияПолей Цикл
        Поиск = Нормализовать(Поле.Имя + " " + Строка(Поле.Синоним));
        Для Каждого КлючевоеСлово Из КлючевыеСлова Цикл
            Если СтрНайти(Поиск, Нормализовать(КлючевоеСлово)) > 0 Тогда
                Результат.Добавить(ОписаниеПоля(Поле));
                Прервать;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЕдинственноеИмя(ОписанияПолей)
    Если ОписанияПолей.Количество() = 1 Тогда
        Возврат ОписанияПолей[0].metadata_name;
    КонецЕсли;
    Возврат "";
КонецФункции

&НаСервереБезКонтекста
Функция ЗначенияПеречисленийПоля(КоллекцияПолей, ОписанияПолей)
    Результат = Новый Массив;
    Для Каждого Описание Из ОписанияПолей Цикл
        Попытка
            ПолеМетаданных = КоллекцияПолей[Описание.metadata_name];
            Для Каждого ТипЗначения Из ПолеМетаданных.Тип.Типы() Цикл
                МетаданныеТипа = Метаданные.НайтиПоТипу(ТипЗначения);
                Если МетаданныеТипа = Неопределено Тогда
                    Продолжить;
                КонецЕсли;
                Для Каждого ЗначениеПеречисления Из МетаданныеТипа.ЗначенияПеречисления Цикл
                    ПолноеПредставление = ЗначениеПеречисления.Имя + " " + Строка(ЗначениеПеречисления.Синоним);
                    Значение = Новый Структура;
                    Значение.Вставить("field", ПолеМетаданных.Имя);
                    Значение.Вставить("enum_metadata_name", МетаданныеТипа.Имя);
                    Значение.Вставить("enum_value_metadata_name", ЗначениеПеречисления.Имя);
                    Значение.Вставить("synonym", Строка(ЗначениеПеречисления.Синоним));
                    Значение.Вставить("is_customer_return_candidate",
                        СтрНайти(Нормализовать(ПолноеПредставление), "возврат") > 0
                        И СтрНайти(Нормализовать(ПолноеПредставление), "покупател") > 0);
                    Результат.Добавить(Значение);
                КонецЦикла;
            КонецЦикла;
        Исключение
            // Не перечисление: значения нескольких документов выводятся ниже.
        КонецПопытки;
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ПримерыДокументов(ИмяДокумента, ИмяОперации)
    Результат = Новый Структура;
    Результат.Вставить("limit", 5);
    Примеры = Новый Массив;
    Результат.Вставить("items", Примеры);
    Результат.Вставить("error", "");
    Попытка
        ТекстЗапроса =
        "ВЫБРАТЬ ПЕРВЫЕ 5
        |   Док.Ссылка КАК Ссылка,
        |   Док.Дата КАК Дата,
        |   Док.Номер КАК Номер,
        |   Док.Проведен КАК Проведен";
        Если НЕ ПустаяСтрока(ИмяОперации) Тогда
            ТекстЗапроса = ТекстЗапроса + ",
            |   Док." + ИмяОперации + " КАК Операция";
        КонецЕсли;
        ТекстЗапроса = ТекстЗапроса + "
        |ИЗ Документ." + ИмяДокумента + " КАК Док
        |УПОРЯДОЧИТЬ ПО Док.Дата УБЫВ";
        Запрос = Новый Запрос;
        Запрос.Текст = ТекстЗапроса;
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            СтрокаДокумента = Новый Структура;
            СтрокаДокумента.Вставить("reference_presentation", Строка(Выборка.Ссылка));
            Попытка
                СтрокаДокумента.Вставить("stable_uuid", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
            Исключение
                СтрокаДокумента.Вставить("stable_uuid", "UUID_NOT_AVAILABLE: " + ОписаниеОшибки());
            КонецПопытки;
            СтрокаДокумента.Вставить("date", Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
            СтрокаДокумента.Вставить("number", Строка(Выборка.Номер));
            СтрокаДокумента.Вставить("posted", Выборка.Проведен);
            Если НЕ ПустаяСтрока(ИмяОперации) Тогда
                СтрокаДокумента.Вставить("operation", ТехническоеОписаниеЗначения(Выборка.Операция));
            КонецЕсли;
            Примеры.Добавить(СтрокаДокумента);
        КонецЦикла;
    Исключение
        Результат.Вставить("error", ОписаниеОшибки());
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ТехническоеОписаниеЗначения(Значение)
    Результат = Новый Структура;
    Результат.Вставить("presentation", Строка(Значение));
    Результат.Вставить("value_type", Строка(ТипЗнч(Значение)));
    Результат.Вставить("serialized", ЗначениеВСтрокуВнутр(Значение));
    МетаданныеТипа = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
    Результат.Вставить("value_metadata_name", ?(МетаданныеТипа = Неопределено, "", МетаданныеТипа.ПолноеИмя()));
    Попытка
        Результат.Вставить("reference_uuid", Строка(Значение.УникальныйИдентификатор()));
    Исключение
        Результат.Вставить("reference_uuid", "");
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция Нормализовать(Значение)
    Результат = НРег(СокрЛП(Строка(Значение)));
    Результат = СтрЗаменить(Результат, " ", "");
    Результат = СтрЗаменить(Результат, "_", "");
    Результат = СтрЗаменить(Результат, "-", "");
    Возврат Результат;
КонецФункции
