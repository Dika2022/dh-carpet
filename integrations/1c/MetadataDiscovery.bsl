// Диагностика не читает SQL и не угадывает технические имена.
// Результат нужно сохранить и использовать для реализации document adapters.

Функция ОписаниеМетаданныхОбъекта(ОбъектМетаданных) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("Имя", ОбъектМетаданных.Имя);
    Результат.Вставить("Синоним", Строка(ОбъектМетаданных.Синоним));
    Реквизиты = Новый Массив;
    Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
        Реквизиты.Добавить(Новый Структура("Имя,Синоним", Реквизит.Имя, Строка(Реквизит.Синоним)));
    КонецЦикла;
    Результат.Вставить("Реквизиты", Реквизиты);
    ТабличныеЧасти = Новый Массив;
    Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
        Колонки = Новый Массив;
        Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
            Колонки.Добавить(Новый Структура("Имя,Синоним", Реквизит.Имя, Строка(Реквизит.Синоним)));
        КонецЦикла;
        ТабличныеЧасти.Добавить(Новый Структура("Имя,Синоним,Колонки", ТабличнаяЧасть.Имя, Строка(ТабличнаяЧасть.Синоним), Колонки));
    КонецЦикла;
    Результат.Вставить("ТабличныеЧасти", ТабличныеЧасти);
    Возврат Результат;
КонецФункции

Функция НайтиДокументыПоПредставлению() Экспорт
    Результат = Новый Массив;
    Для Каждого Документ Из Метаданные.Документы Цикл
        Представление = НРег(Документ.Имя + " " + Строка(Документ.Синоним));
        Если СтрНайти(Представление, "расход") > 0
            Или СтрНайти(Представление, "приход") > 0
            Или СтрНайти(Представление, "возврат") > 0 Тогда
            Результат.Добавить(ОписаниеМетаданныхОбъекта(Документ));
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции
