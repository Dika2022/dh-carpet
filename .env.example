# Пример конфигурации разработки. Не добавляйте сюда реальные секреты.
APP_ENV=development
SERVICE_CHECK_TIMEOUT_SECONDS=3

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dhcarpet
POSTGRES_USER=dhapp
# Только для локальной разработки. Замените заглушку в исключённом из Git .env.
POSTGRES_PASSWORD=replace-with-local-password
# В production вместо POSTGRES_PASSWORD используется Docker secret:
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

REDIS_HOST=redis
REDIS_PORT=6379

QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Локальный ключ для /api/internal/*. В production используйте отдельный secret file.
INTERNAL_API_KEY=replace-with-local-internal-api-key
# INTERNAL_API_KEY_FILE=/run/secrets/internal_api_key
